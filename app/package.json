{
  "name": "widener-stream-overlay-app",
  "version": "2.5.0",
  "private": true,
  "description": "Esports stream overlay control app: one install for every team and league profile",
  "main": "main.js",
  "author": "Widener University Esports",
  "scripts": {
    "start": "electron .",
    "start:widener": "electron . --profile=widener",
    "start:lote": "electron . --profile=lote",
    "start:messiah": "electron . --profile=messiah",
    "server": "node server.js",
    "server:lote": "node server.js --profile=lote",
    "server:messiah": "node server.js --profile=messiah",
    "dist": "node build/dist.js",
    "icons": "electron build/make-icon.js",
    "stinger": "electron build/make-stinger.js",
    "design": "node dev/design-server.js",
    "test:broadcast": "node dev/test-broadcast.js",
    "test:standings": "node dev/test-standings.js",
    "test:standings:visual": "electron dev/review-standings.js",
    "test:feed": "node dev/test-league-feed.js",
    "test:stats-entrance": "electron dev/test-stats-entrance.js",
    "test:playercams": "node dev/test-playercams.js",
    "test:messiah": "node dev/test-messiah.js",
    "test:messiah:visual": "electron dev/review-messiah.js",
    "test:headlines": "electron dev/test-headline-motion.js",
    "test:profile-lock": "electron dev/test-profile-lock.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.22.2",
    "obs-websocket-js": "^5.0.8",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "edu.widener.esports.streamcontrol",
    "productName": "Esports Stream Control",
    "directories": {
      "output": "dist/app"
    },
    "files": [
      "main.js",
      "picker-preload.js",
      "server.js",
      "necc.js",
      "standings.js",
      "league-standings.js",
      "obs.js",
      "montages.js",
      "rlstats.js",
      "profile.js",
      "broadcast.js",
      "package.json",
      "templates/**/*",
      "icons/**/*",
      "public/**/*",
      "profiles/**/*",
      "!profiles/*/local.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Esports-Stream-Control-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bos-tn",
        "repo": "widener-stream-control-app"
      }
    ]
  }
}
