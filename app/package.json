{
  "name": "widener-stream-overlay-app",
  "version": "1.0.0",
  "private": true,
  "description": "Esports stream overlay control app, one build per league profile",
  "main": "main.js",
  "author": "Widener University Esports",
  "scripts": {
    "start": "electron .",
    "start:lote": "electron . --profile=lote",
    "server": "node server.js",
    "server:lote": "node server.js --profile=lote",
    "dist": "node build/dist.js",
    "dist:widener": "node build/dist.js widener",
    "dist:lote": "node build/dist.js lote",
    "icons": "electron build/make-icon.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.22.2",
    "obs-websocket-js": "^5.0.8",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "edu.widener.esports.streamcontrol",
    "productName": "Widener Esports Stream Control",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "necc.js",
      "obs.js",
      "montages.js",
      "rlstats.js",
      "profile.js",
      "package.json",
      "templates/**/*",
      "public/**/*",
      "profiles/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "profiles/widener/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Widener-Esports-Stream-Control-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bos-tn",
        "repo": "widener-stream-control-app"
      }
    ]
  }
}
